# =============================================================================
# SAMAQU HR — environment template
# Salin ke .env.local untuk development, lalu isi nilai aslinya.
# Jangan commit nilai asli: .gitignore sudah mengecualikan semua .env* kecuali file ini.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC (NEXT_PUBLIC_*) — ikut ter-bundle ke browser. Jangan taruh secret di sini.
# -----------------------------------------------------------------------------

# URL project Supabase. Wajib di Production dan Preview (dipakai saat build & runtime).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/publishable key Supabase. Aman di browser karena akses dibatasi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Domain publik halaman karir. Wajib di Production supaya link lowongan dan
# tombol salin mengarah ke karir.samaqu.id; fallback relatif /karir saat kosong.
NEXT_PUBLIC_CAREERS_URL=https://karir.samaqu.id

# Opsional, tidak perlu diisi di Vercel. Hanya override URL keluar menuju
# project Samaqu Academy; default di kode: https://academy.samaqu.id
NEXT_PUBLIC_ACADEMY_URL=https://academy.samaqu.id

# -----------------------------------------------------------------------------
# SECRET SERVER-ONLY — hanya untuk server/route handler. Jangan pernah pakai prefix NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Service role key Supabase (mem-bypass RLS). Dipakai untuk manajemen akun admin,
# upload CV rekrutmen, rate limit form lamaran, dan cron retensi CV.
# Wajib di Production; jangan pernah diimport dari client component.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Secret untuk mengotorisasi GET /api/cron/cv-retention.
# Set di Vercel; Vercel Cron otomatis mengirim header "Authorization: Bearer <CRON_SECRET>".
# Tanpa ini endpoint cron merespons 503 dan retensi CV tidak berjalan.
CRON_SECRET=<random-long-secret>

# -----------------------------------------------------------------------------
# LOCAL OPS SCRIPTS — hanya untuk development/audit lokal, tidak perlu diisi di Vercel.
# -----------------------------------------------------------------------------

# Password database untuk scripts/db-*.mjs (koneksi Postgres langsung).
SAMAQU_DB_PASSWORD=<database-password>

# Opsional. Connection string penuh sebagai alternatif untuk scripts/db-audit.mjs.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Opsional. Target URL aplikasi untuk scripts/security-audit.mjs dan regression-pages.mjs.
# Default: http://localhost:3000
APP_URL=http://localhost:3000
